        };


        spiController11: spi@0x8000B000 {
            compatible = "cdns,spi-r1p6";
            status = "okay";
            reg = <0x8000B000 0x1000>;
            interrupts = <0 56 4>;
            clock-names = "ref_clk", "pclk";
            clocks = <&clkc 25>, <&clkc 34>;
            #address-cells = <1>;
            #size-cells = <0>;

            m25p80@0 {
                #address-cells = <1>;
                #size-cells = <1>;
                compatible = "m25p80","jedec,spi-nor";
                reg = <0>;
                spi-max-frequency = <5000000>;

                partition@0 {
                    label = "slsc_slot11";
                    reg = <0x0 0x100000>;
                };
            };


            spidev@1 {
