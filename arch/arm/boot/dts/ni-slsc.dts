        spiController12: spi@0x8000C000 {
            compatible = "cdns,spi-r1p6";
            status = "okay";
            reg = <0x8000C000 0x1000>;
            interrupts = <0 57 4>;
            clock-names = "ref_clk", "pclk";
            clocks = <&clkc 25>, <&clkc 34>;
